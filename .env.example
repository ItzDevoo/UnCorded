# Database (Neon PostgreSQL)
DATABASE_URL=

# Redis (ioredis TCP connection)
REDIS_URL=redis://localhost:6379

# Cloudflare Tunnel (Docker deployment)
CLOUDFLARED_TUNNEL_TOKEN=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# OAuth — Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUPPORTER_PRICE_ID=
STRIPE_SERVER_OWNER_PRICE_ID=

# App
APP_URL=
CORS_ORIGIN=
NODE_ENV=development
PORT=3000

# Rate Limiting (optional, sensible defaults applied)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# TURN Relay (Cloudflare Calls — required for Supporter+ NAT traversal)
TURN_KEY_API_TOKEN=
TURN_KEY_ID=
