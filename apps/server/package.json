{
  "name": "@uncorded/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file=../../.env --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run --env-file=../../.env src/db/migrate.ts",
    "db:generate": "bun run --env-file=../../.env bunx drizzle-kit generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1008.0",
    "@elysiajs/cors": "^1",
    "@neondatabase/serverless": "^1",
    "@uncorded/protocol": "workspace:*",
    "@uncorded/shared": "workspace:*",
    "@upstash/redis": "^1.36.4",
    "better-auth": "^1",
    "drizzle-orm": "^0.45",
    "elysia": "^1",
    "elysia-rate-limit": "^4",
    "nanoid": "^5",
    "stripe": "^20.4.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "drizzle-kit": "^0.31",
    "vitest": "^4.0.18"
  }
}
