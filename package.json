{
  "name": "uncorded",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev-runner.ts",
    "dev:server": "turbo dev --filter @uncorded/server",
    "dev:web": "turbo dev --filter @uncorded/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "test": "turbo test",
    "fmt": "oxfmt .",
    "db:migrate": "bun run --filter @uncorded/server db:migrate"
  },
  "devDependencies": {
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "sharp": "^0.34.5",
    "turbo": "^2",
    "typescript": "^5.7"
  },
  "packageManager": "bun@1.2.20"
}
