{
  "name": "uncorded",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev-runner.ts",
    "dev:server": "turbo dev --filter @uncorded/server",
    "dev:web": "turbo dev --filter @uncorded/web",
    "dev:desktop": "turbo dev --filter @uncorded/desktop",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "db:migrate": "bun run --filter @uncorded/server db:migrate",
    "build:desktop": "bun run --filter @uncorded/desktop build",
    "pack:desktop": "bun run --filter @uncorded/desktop pack",
    "dist:desktop": "bun run --filter @uncorded/desktop dist"
  },
  "devDependencies": {
    "happy-dom": "^20.8.9",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "sharp": "^0.34.5",
    "turbo": "^2",
    "typescript": "^5.7"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.20",
  "dependencies": {
    "@stripe/stripe-js": "^8.10.0"
  }
}
