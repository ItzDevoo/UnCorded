{
  "id": "excalidraw-boards",
  "name": "Excalidraw Boards",
  "version": "1.0.0",
  "description": "Collaborative whiteboard — create boards and draw together in real-time",
  "author": "UnCorded",
  "scope": "server",
  "runtime": {
    "image": "excalidraw-boards:latest",
    "port": 3000,
    "healthCheck": "/health"
